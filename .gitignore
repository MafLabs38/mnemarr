reports/

# Rust (collector)
collector/target/

# Binding of the SonarQube for IDE extension to a server: per developer, it names the server
.sonarlint/

# Local overrides of the settings: they can hold secrets
src/**/appsettings.*.json
!src/**/appsettings.json

# Drop folder for images the maintainer hands over: never committed as they are
import-image/

