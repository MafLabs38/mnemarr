# Tests
/coverage
TestResults/

# User secrets
secrets.json

# Environment
.env
.env.local

# System
.DS_Store
Thumbs.db

# Logs
*.log

# Local data folder for development
.data/

# Frontend / tooling
node_modules/
.yarn/
dist/
coverage/
TestResults/
.env
.env.*
!.env.example

# Frontend
node_modules/
_output/
playwright-report/
